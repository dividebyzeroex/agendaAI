{
  "name": "agenda-ai",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/api/bridge?__handler=ping"
    },
    {
      "source": "/api/hotmart-activate",
      "destination": "/api/bridge?__handler=hotmart-activate"
    },
    {
      "source": "/api/public-booking",
      "destination": "/api/bridge?__handler=public-booking"
    },
    {
      "source": "/api/respond-appointment",
      "destination": "/api/bridge?__handler=respond-appointment"
    },
    {
      "source": "/api/send-comanda",
      "destination": "/api/bridge?__handler=send-comanda"
    },
    {
      "source": "/api/trigger-workflow",
      "destination": "/api/bridge?__handler=trigger-workflow"
    },
    {
      "source": "/api/sms/send",
      "destination": "/api/bridge?__handler=sms-send"
    },
    {
      "source": "/api/cron/bot-recepcao",
      "destination": "/api/bridge?__handler=bot-recepcao"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/billing?action=checkout"
    },
    {
      "source": "/api/verify-session",
      "destination": "/api/billing?action=verify"
    },
    {
      "source": "/api/get-invoices",
      "destination": "/api/billing?action=invoices"
    },
    {
      "source": "/api/cancel-subscription",
      "destination": "/api/billing?action=cancel"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/commercial?action=run",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/commercial.ts": {
      "maxDuration": 60
    },
    "api/bridge.ts": {
      "maxDuration": 60
    }
  }
}
